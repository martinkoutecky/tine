  // Directed recovery and ownership scenarios. These also exercise the parts
  // of the contract for which the host conformance driver has no action yet.
  action openPairPage(p: int): bool = wOpen(p).then(deliverUp(true)).then(wRecv(p))
  action takeDisk(p: int): bool = wDiscard(p).then(deliverUp(true)).then(wRecv(p))
  action writeMember(p: int): bool = flush(p).then(check).then(rename).then(dirSync(true))
  action removeSource(p: int): bool = flushDel(p).then(check).then(rename).then(dirSync(true))
  action admitted = load(0).then(load(1)).then(load(2)).then(opRename(0, 2, Set(1), Map(1 -> 3)))
  action checkedMembers = admitted.then(writeMember(2)).then(writeMember(1))
  action settled = checkedMembers.then(removeSource(0))
  action movedAndReplaced = checkedMembers.then(flushDel(0)).then(check).then(rename)
    .then(extWrite(2, 3)).then(dirSync(true))
  val safe = guarantee and orderHolds and renameResolves and draftOwner and retainedRecords
  val completed = s.disk.get(0) == ABSENT and s.disk.get(2) == 1 and s.trash.get(0).contains(1)

  run ownPairRewriteLeavesNothingToReinstall = init.then(settled).then(pairRewrite(0, true)).then(crash).then(launch)
    .expect(completed and s.gates == List() and s.pairs == List() and safe)
  run ownPairCrashBeforeRewriteRewitnessesExactState = init.then(settled).then(crash).then(launch)
    .expect(s.gates != List() and safe).then(writeMember(2)).then(writeMember(1)).then(removeSource(0))
    .expect(completed and s.gates == List() and safe)
  run ownPairFailedRewriteKeepsVehicle = init.then(settled).then(pairRewrite(0, false)).then(crash).then(launch)
    .expect(s.gates != List() and safe).then(writeMember(2)).then(writeMember(1)).then(removeSource(0))
    .then(pairRewrite(0, true)).then(crash).then(launch).expect(completed and s.pairs == List() and safe)
  run ownPairOutsideChangeBeforeRewriteConflicts = init.then(settled).then(extWrite(2, 3)).then(crash).then(launch)
    .then(flush(2)).then(check).expect(s.pages.get(2).conflict and s.pairs != List() and safe)
  run ownPairRestoresSourceAfterRacedReceiver = init.then(movedAndReplaced).then(openPairPage(2)).then(takeDisk(2))
    .then(crash).then(launch).then(restoreSource(0)).then(draftSync(0)).then(writeMember(0))
    .expect(s.disk.get(0) == 1 and s.disk.get(2) == 3 and safe)
  run ownPairOccupiedSourceRetainsPreimage = init.then(movedAndReplaced).then(extWrite(0, 2))
    .then(openPairPage(2)).then(takeDisk(2)).then(crash).then(launch)
    .expect(s.pairs.head().phase == "retained" and s.pairs.head().records.get(0).base == 1 and safe)
    .then(restoreSource(0).fail())
  run ownPairCannotRestoreOverClaimant = init.then(movedAndReplaced).then(openPairPage(2)).then(takeDisk(2))
    .then(extClaim(0, true)).then(crash).then(launch).expect(safe).then(restoreSource(0).fail())
  run ownPairSourceCheckResumesOnCertifiedReceiver = init.then(checkedMembers).then(extWrite(2, 3)).then(flushDel(0)).then(check)
    .expect(s.disk.get(0) == 1 and s.pairs.head().phase == "held" and safe)
    .then(extWrite(2, 1)).then(observe(2)).then(removeSource(0)).expect(completed and safe)
  run ownPairVolatileReceiverIsNotCertified = init.then(checkedMembers).then(extWrite(2, 3)).then(extWriteD(2, 1, false))
    .then(flushDel(0)).then(check).expect((if (RACES.contains("weak")) s.job.phase == 2
      else s.pairs.head().phase == "held" and not(s.job.on)) and s.disk.get(0) == 1 and safe)
  run ownPairPostcheckResumesOnCertifiedReceiver = init.then(movedAndReplaced)
    .expect(s.pairs.head().phase == "moved" and s.pairs.head().records.get(0).base == 1 and safe)
    .then(extWrite(2, 1)).then(observe(2)).expect(s.pairs.head().phase == "settled" and completed and safe)
  run ownPairTakeDiskWaitsForDurableDecision = init.then(admitted).then(openPairPage(2)).then(draftStore(false)).then(takeDisk(2))
    .expect(s.pairs.head().decision == "none" and s.pages.get(0).buf == ABSENT and s.pages.get(2).buf == 1 and safe)
    .then(draftStore(true)).then(takeDisk(2)).then(powerK(Set())).then(launch)
    .expect(s.pairs.head().decision == "cancelled" and not(s.pages.get(0).held) and s.disk.get(0) == 1 and safe)
  run ownPairUnreadableDecisionBlocksRemoval = init.then(admitted).then(unreadableDecision(2)).then(crash).then(launch)
    .then(writeMember(2)).then(writeMember(1)).expect(s.pairs.head().phase == "blocked" and safe).then(flushDel(0).fail())
  run ownPairSwitchWithRetainedRecords = init.then(admitted).then(writeMember(2)).then(switchFin).then(launch)
    .expect(s.drafts.get(2).bytes == 1 and s.gates != List() and safe)
  run ownPairNewerSourceDisarmsRemoval = init.then(checkedMembers).then(openPairPage(0))
    .then(wEdit(0, 3)).then(wSend(0)).then(deliverUp(true)).then(wRecv(0)).then(draftSync(0)).then(writeMember(0))
    .expect(s.pairs.head().decision == "disarmed" and s.disk.get(0) == 3 and safe)
    .then(crash).then(launch).expect(s.gates == List() and s.pages.get(0).buf == 3 and safe)
  run ownPairOwnerClaimFailsWithExistingOwner = init.then(admitted).then(crash).then(otherOwner(true)).then(launch)
    .expect(s.owners == Set(1) and safe).then(writeMember(2)).then(writeMember(1)).then(pairedDraftFailure(0))
    .expect(s.disk.get(0) == 1 and s.disk.get(2) == 1 and safe).then(flushDel(0).fail())
  run ownPairUnsupportedClaimPermitsPageSave = init.then(crash).then(launchWithClaim(false)).then(openPairPage(0))
    .then(wEdit(0, 3)).then(wSend(0)).then(deliverUp(true)).then(wRecv(0)).then(writeMember(0))
    .expect(s.owners == Set() and s.disk.get(0) == 3 and safe)
