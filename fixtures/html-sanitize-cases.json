{
  "_comment": "Cross-language contract fixtures for the raw-HTML sanitizer. Consumed by BOTH src/render/htmlSanitize.test.tsx (DOMPurify) and crates/tine-core/src/html_sanitize.rs (ammonia) so the app and the static-HTML export enforce the SAME allowlist. Assertions are on tolerant substrings (tag opener, url, stripped-token) rather than exact serialization, since DOMPurify and ammonia serialize attributes differently.",
  "cases": [
    { "name": "ins-survives",        "input": "<ins>added</ins>",                                   "mustContain": ["<ins", "added"],            "mustNotContain": [] },
    { "name": "del-survives",        "input": "<del>removed</del>",                                 "mustContain": ["<del", "removed"],          "mustNotContain": [] },
    { "name": "sup-survives",        "input": "x<sup>2</sup>",                                      "mustContain": ["<sup", "2"],                "mustNotContain": [] },
    { "name": "sub-survives",        "input": "H<sub>2</sub>O",                                     "mustContain": ["<sub", "2"],                "mustNotContain": [] },
    { "name": "kbd-survives",        "input": "<kbd>Ctrl</kbd>",                                    "mustContain": ["<kbd", "Ctrl"],             "mustNotContain": [] },
    { "name": "mark-survives",       "input": "<mark>hi</mark>",                                    "mustContain": ["<mark", "hi"],              "mustNotContain": [] },
    { "name": "u-survives",          "input": "<u>underline</u>",                                   "mustContain": ["<u>", "underline"],         "mustNotContain": [] },
    { "name": "abbr-title-survives", "input": "<abbr title=\"Hyper Text\">HT</abbr>",               "mustContain": ["<abbr", "Hyper Text", "HT"],"mustNotContain": [] },
    { "name": "img-https-survives",  "input": "<img src=\"https://e.com/a.png\" alt=\"a\" width=\"320\">", "mustContain": ["<img", "https://e.com/a.png", "alt=\"a\"", "320"], "mustNotContain": [] },
    { "name": "a-https-survives",    "input": "<a href=\"https://x.com\">y</a>",                    "mustContain": ["<a", "https://x.com", "y"], "mustNotContain": [] },
    { "name": "div-class-survives",  "input": "<div class=\"note\">body</div>",                     "mustContain": ["<div", "class=\"note\"", "body"], "mustNotContain": [] },

    { "name": "strip-script",        "input": "<script>steal()</script>ok",                         "mustContain": ["ok"],                       "mustNotContain": ["<script", "steal()"] },
    { "name": "strip-onerror",       "input": "<img src=\"https://e.com/a.png\" onerror=\"steal()\">", "mustContain": ["<img", "https://e.com/a.png"], "mustNotContain": ["onerror", "steal()"] },
    { "name": "strip-onclick",       "input": "<div onclick=\"steal()\">z</div>",                   "mustContain": ["<div", "z"],                "mustNotContain": ["onclick", "steal()"] },
    { "name": "strip-onmouseover",   "input": "<b onmouseover=\"x()\">bold</b>",                    "mustContain": ["<b", "bold"],               "mustNotContain": ["onmouseover", "x()"] },
    { "name": "strip-js-href",       "input": "<a href=\"javascript:steal()\">click</a>",           "mustContain": ["click"],                    "mustNotContain": ["javascript:", "steal()"] },
    { "name": "strip-js-img-src",    "input": "<img src=\"javascript:steal()\">",                   "mustContain": [],                           "mustNotContain": ["javascript:", "steal()"] },
    { "name": "strip-style-attr",    "input": "<span style=\"position:fixed\">t</span>",            "mustContain": ["<span", "t"],               "mustNotContain": ["position:fixed", "style="] },
    { "name": "strip-iframe",        "input": "<iframe src=\"https://evil.example\"></iframe>after", "mustContain": ["after"],                    "mustNotContain": ["<iframe"] },
    { "name": "style-keeps-colour-only", "input": "<span style=\"color:#c00;position:fixed;background-color:url(https://t.example/x)\">t</span>", "mustContain": ["<span style=\"color: #c00\">t</span>"], "mustNotContain": ["position", "url("] },
    { "name": "style-one-colour-rule", "input": "<span style=\"color:\uFEFFred;background-color:#0c0\">t</span>", "mustContain": ["<span style=\"color: red; background-color: #0c0\">t</span>"], "mustNotContain": ["\uFEFF"] },
    { "name": "style-highlight-variable-kept", "input": "<mark style=\"background-color: var(--ls-highlight-color-red, #fdd8d8)\">t</mark>", "mustContain": ["<mark style=\"background-color: var(--ls-highlight-color-red, #fdd8d8)\">t</mark>"], "mustNotContain": [] },
    { "name": "style-highlight-variable-spacing-and-case", "input": "<mark style=\"Background-Color:VAR( --ls-highlight-color-gray ,#E8E8E8 )\">t</mark>", "mustContain": ["<mark style=\"background-color: VAR( --ls-highlight-color-gray ,#E8E8E8 )\">t</mark>"], "mustNotContain": [] },
    { "name": "style-other-variable-dropped", "input": "<mark style=\"background-color: var(--anything-else, #fdd8d8)\">t</mark>", "mustContain": ["<mark>t</mark>"], "mustNotContain": ["var(", "style="] },
    { "name": "style-highlight-variable-unknown-name-dropped", "input": "<mark style=\"background-color: var(--ls-highlight-color-orange, #fdd8d8)\">t</mark>", "mustContain": ["<mark>t</mark>"], "mustNotContain": ["var(", "style="] },
    { "name": "style-highlight-variable-name-case-dropped", "input": "<mark style=\"background-color: var(--ls-highlight-color-Red, #fdd8d8)\">t</mark>", "mustContain": ["<mark>t</mark>"], "mustNotContain": ["var(", "style="] },
    { "name": "style-highlight-variable-needs-hex-fallback", "input": "<mark style=\"background-color: var(--ls-highlight-color-red); background-color: var(--ls-highlight-color-red, red); background-color: var(--ls-highlight-color-red, rgb(1, 2, 3))\">t</mark>", "mustContain": ["<mark>t</mark>"], "mustNotContain": ["var(", "style="] },
    { "name": "style-highlight-variable-url-fallback-dropped", "input": "<mark style=\"background-color: var(--ls-highlight-color-red, url(https://t.example/x))\">t</mark>", "mustContain": ["<mark>t</mark>"], "mustNotContain": ["url(", "var(", "style="] },
    { "name": "style-highlight-variable-nested-dropped", "input": "<mark style=\"background-color: var(--ls-highlight-color-red, var(--x, #fff)); background-color: var(--ls-highlight-color-red, #fff, #000)\">t</mark>", "mustContain": ["<mark>t</mark>"], "mustNotContain": ["var(", "style="] },
    { "name": "style-highlight-variable-background-only", "input": "<mark style=\"color: var(--ls-highlight-color-red, #fdd8d8); text-decoration-color: var(--ls-highlight-color-red, #fdd8d8)\">t</mark>", "mustContain": ["<mark>t</mark>"], "mustNotContain": ["var(", "style="] },
    { "name": "style-feff-at-property-start", "hiccup": "[:span {:style \"\uFEFFcolor:red\"} \"t\"]", "input": "<span style=\"\uFEFFcolor:red\">t</span>", "mustContain": ["<span style=\"color: red\">t</span>"], "mustNotContain": ["\uFEFF"] },
    { "name": "style-feff-at-property-end", "hiccup": "[:span {:style \"color\uFEFF:red\"} \"t\"]", "input": "<span style=\"color\uFEFF:red\">t</span>", "mustContain": ["<span style=\"color: red\">t</span>"], "mustNotContain": ["\uFEFF"] },
    { "name": "style-feff-at-value-start", "hiccup": "[:span {:style \"color:\uFEFFred\"} \"t\"]", "input": "<span style=\"color:\uFEFFred\">t</span>", "mustContain": ["<span style=\"color: red\">t</span>"], "mustNotContain": ["\uFEFF"] },
    { "name": "style-feff-at-value-end", "hiccup": "[:span {:style \"color:red\uFEFF\"} \"t\"]", "input": "<span style=\"color:red\uFEFF\">t</span>", "mustContain": ["<span style=\"color: red\">t</span>"], "mustNotContain": ["\uFEFF"] },
    { "name": "style-nel-at-property-start", "hiccup": "[:span {:style \"\u0085color:red\"} \"t\"]", "input": "<span style=\"\u0085color:red\">t</span>", "mustContain": ["<span>t</span>"], "mustNotContain": ["style=", "red"] },
    { "name": "style-nel-at-property-end", "hiccup": "[:span {:style \"color\u0085:red\"} \"t\"]", "input": "<span style=\"color\u0085:red\">t</span>", "mustContain": ["<span>t</span>"], "mustNotContain": ["style=", "red"] },
    { "name": "style-nel-at-value-start", "hiccup": "[:span {:style \"color:\u0085red\"} \"t\"]", "input": "<span style=\"color:\u0085red\">t</span>", "mustContain": ["<span>t</span>"], "mustNotContain": ["style=", "red"] },
    { "name": "style-nel-at-value-end", "hiccup": "[:span {:style \"color:red\u0085\"} \"t\"]", "input": "<span style=\"color:red\u0085\">t</span>", "mustContain": ["<span>t</span>"], "mustNotContain": ["style=", "red"] },
    {
      "name": "hiccup-export-equals-sanitize",
      "hiccup": "[:div {:style \"position:fixed;inset:0;background:#fff\" :onclick \"steal()\"} [:span {:style \"color:#c00\"} \"red\"] [:form [:input {:name \"pw\"}] [:button \"Log in\"]]]",
      "input": "<div style=\"position:fixed;inset:0;background:#fff\" onclick=\"steal()\"><span style=\"color:#c00\">red</span><form><input name=\"pw\"><button>Log in</button></form></div>",
      "mustContain": ["<div>", "<span style=\"color: #c00\">red</span>", "Log in"],
      "mustNotContain": ["position", "inset", "onclick", "steal()", "<form", "<input", "<button"]
    }
  ]
}
