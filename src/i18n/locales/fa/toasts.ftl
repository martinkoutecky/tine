        [ref] شناسهٔ بلوک ذخیره نشد؛ ارجاع کپی نشد.
       *[embed] شناسهٔ بلوک ذخیره نشد؛ جاسازی کپی نشد.
    }
block-link-copy-copied =
    { $kind ->
        [ref] ارجاع بلوک کپی شد
       *[embed] جاسازی بلوک کپی شد
