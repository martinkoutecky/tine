theme-preference-could-not-update-system-bar-appearance = ظاهر نوار سیستم به‌روز نشد.
manager-installed-theme-settings-are-invalid = تنظیمات پوسته‌های نصب‌شده نامعتبر است.
manager-some-installed-themes-could-not-be-loaded = برخی پوسته‌های نصب‌شده بارگذاری نشدند.
manager-installed-theme-settings-could-not-be-parsed = تنظیمات پوسته‌های نصب‌شده تجزیه نشد.
manager-could-not-load-installed-themes = پوسته‌های نصب‌شده بارگذاری نشدند.
tray-the-tray-setting-was-saved-but-could-not = تنظیم سینی ذخیره شد، اما اکنون اعمال نشد.
workspace-windows-at-most-extra-windows-can-be-open-at = حداکثر { $windowLimit } پنجرهٔ اضافی می‌تواند هم‌زمان باز باشد.
workspace-windows-couldn-t-open-a-new-window = پنجرهٔ جدید باز نشد.
workspaces-workspace-changes-are-visible-but-directory-sync-failed = تغییرات فضای کار دیده می‌شوند، اما همگام‌سازی پوشه ناموفق بود؛ شاید با قطع برق از بین بروند.
zoom-could-not-apply-interface-zoom = بزرگ‌نمایی رابط اعمال نشد.
zoom-could-not-save-interface-zoom = بزرگ‌نمایی رابط ذخیره نشد.
ui-failure-custom-css = custom.css خوانده نشد. هیچ CSS سفارشی‌ای اعمال نشد؛ اگر تازه ویرایشش کردید، نسخهٔ قبلی همچنان برقرار است. فایل را اصلاح و دوباره ذخیره کنید.
ui-failure-css-draft = رونوشت بازیابی CSSی که ویرایش می‌کنید نگه داشته نشد. فایل ذخیره نشد؛ پیش از بستن ویرایشگر تغییراتتان را کپی کنید.
ui-failure-asset-read = فایلی از پیوست‌های این گراف خوانده نشد. شاید ناخوانا باشد.
ui-failure-page-refresh = صفحه پس از تغییر تازه نشد. برای دیدن آخرین نسخه دوباره بازش کنید.
ui-failure-logbook = ورودی ردگیری زمان خوانده یا به‌روز نشد.
ui-failure-marker-read = نشانگر وظیفهٔ یک بلوک خوانده نشد. به‌صورت متن ساده نمایش داده می‌شود.
ui-failure-page-header-read = سرصفحهٔ ویژگی‌های صفحه خوانده نشد. به‌صورت متن معمولی نمایش داده می‌شود.
ui-failure-export-preview = بلوکی برای پیش‌نمایش خروجی آماده نشد. حل‌نشده نمایش داده می‌شود.
ui-failure-sheet-export = برگه‌ها برای خروجی خوانده نشدند. به‌صورت طرح ساده خروجی گرفته می‌شوند.
ui-failure-editor-load = ویرایشگر CodeMirror بارگیری نشد. می‌توانید با ویرایشگر کلاسیک به ویرایش ادامه دهید.
ui-failure-config-read = config.edn خوانده نشد. گراف فقط‌خواندنی باز است؛ پیکربندی را اصلاح کنید و گراف را دوباره باز کنید.
ui-failure-conflict-inventory = تعارض‌ها تازه نشدند. آخرین فهرست موفق نگه داشته شد.
ui-failure-graph-verification = فایل‌های گراف راستی‌آزمایی نشدند.
ui-failure-unreadable-files =
    { $more ->
        [0] برخی فایل‌های صفحه خوانده نشدند: { $names }. بقیهٔ گراف در دسترس است.
       *[other] برخی فایل‌های صفحه خوانده نشدند: { $names } و { NUMBER($more, useGrouping: 0) } مورد دیگر («کپی» همه را فهرست می‌کند). بقیهٔ گراف در دسترس است.
    }
ui-failure-asset-inventory = پیوست‌های بی‌ارجاع بررسی نشدند. آخرین پویش موفق نگه داشته شد.
ui-failure-trash-inventory = زباله‌دان قابل‌بازیابی بررسی نشد. آخرین شمارش موفق نگه داشته شد.
ui-failure-backup-read = پشتیبان آغاز اجرا کامل نشد. گراف شما همچنان باز است.
ui-failure-backup-feedback = به‌روزرسانی وضعیت پشتیبان دریافت نشد.
ui-failure-page-inventory = فهرست صفحه‌ها تازه نشد. آخرین فهرست بارگذاری‌شده نگه داشته شد.
ui-failure-session-read = نشست ذخیره‌شده بارگذاری نشد. فضای کار کنونی نگه داشته شد.
ui-failure-template-read = فهرست الگوها بارگذاری نشد. پیش از ساختن الگو دوباره امتحان کنید.
ui-failure-template-write = الگو ساخته نشد. این بلوک دیگر قابل نوشتن نیست.
ui-failure-journal-feed = روزنوشت‌های بیشتر بارگذاری نشدند. دوباره امتحان کنید.
ui-failure-block-counts = شمارش ارجاع‌های بلوک تازه نشد. آخرین شمارش‌ها نگه داشته شدند.
ui-failure-block-resolution = ارجاع‌های بلوک حل نشدند. دوباره امتحان کنید.
ui-failure-external-link = پیوند باز نشد.
ui-failure-capture-preference = تنظیم یادداشت سریع بارگذاری نشد.
ui-failure-audio-load = این فایل صوتی بارگذاری نشد.
ui-failure-audio-play = این فایل صوتی پخش نشد.
ui-failure-clipboard-association = این بلوک‌ها چسبانده نشدند.
ui-failure-window-state = وضعیت پنجره خوانده نشد.
ui-failure-window-action = پنجره تغییر نکرد.
ui-failure-pdf-find = جستجو در این PDF انجام نشد. نتایج جستجو پاک شدند.
ui-failure-query-hydration = این صفحهٔ پرس‌وجو برای ویرایش بارگذاری نشد.
defender-hint-offer = باز شدن این گراف طول کشید و Windows Defender هر فایلی را که Tine می‌خواند پویش می‌کند. استثنا کردن پوشهٔ این گراف از پویش بی‌درنگ معمولاً بازشدن‌های بعدی را بسیار سریع‌تر می‌کند. این کار تنظیم امنیتی Windows را تغییر می‌دهد، پس تأیید مدیر می‌خواهد و فقط اگر خودتان انتخابش کنید انجام می‌شود.
defender-hint-action = افزودن استثنا برای پوشهٔ این گراف
carry-result =
    { $count ->
        [0] وظیفهٔ ناتمامی برای انتقال نیست
       *[other] { NUMBER($count, useGrouping: 0) } مورد به امروز منتقل شد
    }
guide-copy-result =
    { $created ->
        [1] راهنما در گراف شما زیر tine-guide/ کپی شد.
       *[other] راهنما از قبل در گراف شماست؛ باز شد.
    }
conflict-resolution-applied =
    { $source ->
        [vcs-markers] ادغام «{ $page }» حل شد
        [duplicate-journal] فایل دیگر در «{ $page }» ادغام شد
       *[other] در «{ $page }» ادغام شد
    }
conflict-resolution-draft-changed = پیش‌نویس شما یا فایل تغییر کرد. مقایسهٔ به‌روز را بررسی و دوباره اعمال کنید.
conflict-resolution-latest-saved = آخرین ویرایش شما ذخیره شد. مقایسهٔ به‌روز را بررسی و دوباره اعمال کنید.
conflict-resolution-file-trashed = { $name } به زباله‌دان رفت
conflict-resolution-file-renamed = نام { $old } به { $name } تغییر کرد
share-ingest-captured = در روزنوشت امروز ثبت شد
share-ingest-rejected = { NUMBER($count, useGrouping: 0) } مورد اشتراکی خوانده نشد و در صندوق اشتراک Tine کنار گذاشته شد.
session-save-failed = نشست ذخیره نشد: { $detail }
inpage-replace-skipped = چیزی جایگزین نشد: { NUMBER($count, useGrouping: 0) } تطبیق درون پیوند یا نشانه‌گذاری است.
inpage-replace-result =
    { $skipped ->
        [0] { NUMBER($count, useGrouping: 0) } تطبیق جایگزین شد.
       *[other] { NUMBER($count, useGrouping: 0) } تطبیق جایگزین شد؛ { NUMBER($skipped, useGrouping: 0) } مورد درون پیوند، نشانه‌گذاری یا بلوک فقط‌خواندنی دست‌نخورده ماند.
    }
query-export-dialog-exported =
    { $previous ->
        [1] { $pages } صفحه در { $path } خروجی گرفته شد (خروجی قبلی در { $retired } نگه داشته شد)
       *[other] { $pages } صفحه در { $path } خروجی گرفته شد
    }
defender-hint-result =
    { $outcome ->
        [added] Windows Defender اکنون پوشهٔ این گراف را پویش نمی‌کند. برای دیدن تفاوت گراف را دوباره باز کنید.
        [declined] تغییری انجام نشد: درخواست مدیر تأیید نشد. دفعهٔ بعد که این گراف کند باز شود پیشنهاد برمی‌گردد.
       *[other] Windows Defender این استثنا را نپذیرفت. { $detail }
    }
filedrop-inserted = { NUMBER($count, useGrouping: 0) } فایل درج شد
journal-filename-panel-renamed = نام { NUMBER($count, useGrouping: 0) } فایل روزنوشت تغییر کرد
toasts-reference-change =
    { $known ->
        [0] { $transferred ->
            [1] شاید اکنون ارجاع‌ها به این بلوک اشاره کنند
           *[other] شاید اکنون ارجاع‌ها خراب شده باشند
        }
       *[other] { $transferred ->
            [1] { NUMBER($count, useGrouping: 0) } ارجاع اکنون به این بلوک اشاره می‌کند
           *[other] { NUMBER($count, useGrouping: 0) } ارجاع اکنون خراب است
        }
    }
page-props-stale-panel =
    { $stale ->
        [graph] گراف هنگام باز بودن پانل ویژگی‌هایش تغییر کرد، پس «{ $key }» ذخیره نشد. برای ویرایش پانل را دوباره باز کنید.
        [page] این صفحه هنگام باز بودن پانل ویژگی‌هایش تغییر کرد یا دوباره بارگذاری شد، پس «{ $key }» ذخیره نشد. برای ویرایش پانل را دوباره باز کنید.
       *[block] این بلوک هنگام باز بودن پانل ویژگی‌هایش تغییر کرد یا دوباره بارگذاری شد، پس «{ $key }» ذخیره نشد. برای ویرایش پانل را دوباره باز کنید.
    }
graph-rewrite-conflicted-referrers = { NUMBER($count, useGrouping: 0) } صفحه که هنوز در میانهٔ ادغام است ارجاع‌هایش به «{ $page }» را نگه می‌دارد: { $files }. ادغام را حل و سپس آن‌ها را به‌روز کنید.
block-link-copy-save-failed =
