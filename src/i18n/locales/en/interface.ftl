failure-boundary-slow-operations =
    { $count ->
        [one] Tine is still waiting on an operation that has been running for over { $seconds }s. This is usually why a region fails to appear, and your notes on disk are not affected.
       *[other] Tine is still waiting on { NUMBER($count, useGrouping: 0) } operations that have been running for over { $seconds }s. This is usually why a region fails to appear, and your notes on disk are not affected.
    }
