## Native shell text: the tray menu and the startup screen. Literal text only:
## native code selects these strings and never formats them.
shell-tray-open = Open Tine
shell-tray-capture = Quick Capture
shell-tray-quit = Quit
shell-edit-paste-match-style = Paste and Match Style
shell-boot-opening = Opening Tine…
## CLI output currently selects English, as do the existing CLI replies.
shell-cli-delete-help = Delete a block with its children; refuses broken references without --yes and prints the removed text (up to 65,536 UTF-8 bytes, with omitted byte count)
shell-cli-delete-confirm-help = Confirm deletion even when it breaks incoming block references
shell-cli-delete-broken-count = Block references broken by this deletion:
shell-cli-delete-confirmation = Pass --yes (or --force) to confirm; nothing changed
shell-cli-delete-removed = removed text (block and children):
shell-cli-delete-truncated = removed text truncated at 65536 UTF-8 bytes; omitted bytes:
